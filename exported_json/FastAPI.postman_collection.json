                  "// store id",
                  "let ids = JSON.parse(pm.collectionVariables.get(\"ids\") || \"[]\");",
                  "ids.push(json.id);",
                  "pm.collectionVariables.set(\"ids\", JSON.stringify(ids));",
                  "",
                  "// increment counter",
                  "let count = Number(pm.collectionVariables.get(\"createCount\") || 0);",
                  "count++;",
                  "pm.collectionVariables.set(\"createCount\", count);",
                  "",
                  "console.log(\"--------------------------------------------------\");",
                  "console.log(\"Inside post-request of Create 5 items\");",
                  "console.log(\"Created:\", json.id, \"Count:\", count);",
                  "",
                  "// loop control",
                  "if (count < 5) {",
                  "    pm.execution.setNextRequest(\"MultiCRUD - Create 5 Items\");",
                  "} else {",
                  "    //console.log(\"Switching to DELETE phase\");",
                  "    //pm.execution.setNextRequest(\"MultiCRUD - Delete 5 Items\");",
                  "    console.log(\"Switching to Read Items Post Creation phase\");",
                  "    pm.execution.setNextRequest(\"MultiCRUD - Read Items Post Creation\");",
                  "}",
