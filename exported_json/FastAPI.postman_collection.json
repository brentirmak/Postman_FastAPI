              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is successful', function () {",
                  "    pm.expect(pm.response.code).to.equal(200);",
                  "});",
                  "",
                  "pm.test('Response time is sane', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON when present', function () {",
                  "    const contentType = pm.response.headers.get('Content-Type');",
                  "    if (contentType) {",
                  "        pm.expect(contentType.toLowerCase()).to.include('application/json');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response body has expected item fields', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json).to.be.an('array').and.not.be.empty;",
                  "",
                  "    const item = json[0];",
                  "    pm.expect(item).to.have.property('name');",
                  "    pm.expect(item.name).to.be.a('string').and.not.be.empty;",
                  "",
                  "    pm.expect(item).to.have.property('description');",
                  "    pm.expect(item.description).to.be.a('string');",
                  "",
                  "    pm.expect(item).to.have.property('price');",
                  "    pm.expect(item.price).to.be.a('number').and.be.at.least(0);",
                  "    ",
                  "    pm.expect(item).to.have.property('id');",
                  "    pm.expect(item.id).to.be.a('number');",
                  "    pm.expect(item.id).to.be.above(0);",
                  "});"
                ],
