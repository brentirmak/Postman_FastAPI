            {
              "listen": "test",
              "script": {
                "exec": [
                  "const jsonData = pm.response.json();",
                  "pm.collectionVariables.set(\"new_record_name\", jsonData.name);",
                  "pm.collectionVariables.set(\"new_record_description\", jsonData.description);",
                  "pm.collectionVariables.set(\"new_record_price\", jsonData.price);",
                  "pm.collectionVariables.set(\"new_record_id\", jsonData.id);",
                  "",
                  "pm.test('Status code is successful creation', function () {",
                  "    pm.expect(pm.response.code).to.equal(201);",
                  "});",
                  "",
                  "pm.test('Response time is sane', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "pm.test('Content-Type is JSON when present', function () {",
                  "    const contentType = pm.response.headers.get('Content-Type');",
                  "    if (contentType) {",
                  "        pm.expect(contentType.toLowerCase()).to.include('application/json');",
                  "    }",
                  "});",
                  "",
                  "pm.test('Response body has expected item fields', function () {",
                  "    pm.expect(jsonData).to.have.property('name');",
                  "    pm.expect(jsonData.name).to.be.a('string').and.not.be.empty;",
                  "",
                  "    pm.expect(jsonData).to.have.property('description');",
                  "    pm.expect(jsonData.description).to.be.a('string');",
                  "",
                  "    pm.expect(jsonData).to.have.property('price');",
                  "    pm.expect(Number(jsonData.price)).to.be.a('number').and.be.at.least(0);",
                  "    ",
                  "    pm.expect(jsonData).to.have.property('id');",
                  "    pm.expect(jsonData.id).to.be.a('number');",
                  "    pm.expect(jsonData.id).to.be.above(0);",
                  "});",
                  "",
                  "console.log(\"Created record with ID: \" + pm.collectionVariables.get(\"new_record_id\"));"
